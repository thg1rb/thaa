{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Allows the main window to inspect local runtime listeners and request identity-checked actions.",
  "windows": ["main"],
  "permissions": [
    "allow-get-runtime-snapshot",
    "allow-refresh-runtime-snapshot",
    "allow-request-process-action",
    "allow-open-listener-url",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
