{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tray-popover",
  "description": "Allows the runtime overview popover to read and refresh accepted runtime snapshots and navigate to the main window.",
  "windows": ["tray-popover"],
  "permissions": [
    "allow-get-tray-runtime-snapshot",
    "allow-refresh-runtime-snapshot",
    "allow-navigate-to-runtime-entry",
    "allow-show-main-window",
    "allow-dismiss-tray-popover",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-hide",
    "allow-get-runtime-process-icons"
  ]
}
